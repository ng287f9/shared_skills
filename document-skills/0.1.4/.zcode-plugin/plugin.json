{
  "name": "document-skills",
  "version": "0.1.4",
  "description": "Built-in DOCX and PDF document production skills, published as an official ZCode plugin.",
  "description_i18n": {
    "en": "Document production skills for DOCX, PDF, PPTX, and XLSX.",
    "zh-CN": "面向 DOCX、PDF、PPTX 和 XLSX 的文档制作技能。"
  },
  "author": {
    "name": "Z.ai"
  },
  "license": "SEE LICENSE IN skills/docx/LICENSE.txt",
  "skills": "skills",
  "mcpServers": {
    "image_search": {
      "type": "http",
      "url": "${ZCODE_BASE_URL}/api/v1/mcp/server/image_search",
      "auth": {
        "type": "zcode_official",
        "provider": "jwt_token"
      },
      "timeoutMs": 90000,
      "command": "C:\\Program Files\\ZCode\\ZCode.exe",
      "args": [
        "C:\\Program Files\\ZCode\\resources\\glm\\zcode.cjs",
        "__zcode-plugin-host",
        "C:\\Users\\glenn\\.zcode\\cli\\plugins\\cache\\zcode-plugins-official\\document-skills\\0.1.4\\dist\\mcp\\server.js"
      ],
      "env": {
        "ELECTRON_RUN_AS_NODE": "1",
        "ZCODE_PLUGIN_ID": "document-skills@zcode-plugins-official"
      }
    }
  }
}
